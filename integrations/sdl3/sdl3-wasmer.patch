diff --git a/CMakeLists.txt b/CMakeLists.txt
index a3048f4..02e4c97 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -375,6 +375,7 @@ set_option(SDL_OPENVR              "Use OpenVR video driver" OFF)
 dep_option(SDL_KMSDRM              "Use KMS DRM video driver" ${UNIX_SYS} "SDL_VIDEO" OFF)
 dep_option(SDL_KMSDRM_SHARED       "Dynamically load KMS DRM support" ON "SDL_KMSDRM;SDL_DEPS_SHARED" OFF)
 set_option(SDL_OFFSCREEN           "Use offscreen video driver" ON)
+dep_option(SDL_WASMER_VIDEO        "Use Wasmer GUI video driver" ON "SDL_VIDEO;WASI" OFF)
 dep_option(SDL_DUMMYCAMERA         "Support the dummy camera driver" ON SDL_CAMERA OFF)
 option_string(SDL_BACKGROUNDING_SIGNAL "number to use for magic backgrounding signal or 'OFF'" OFF)
 option_string(SDL_FOREGROUNDING_SIGNAL "number to use for magic foregrounding signal or 'OFF'" OFF)
@@ -1807,6 +1808,31 @@ elseif(WASI)
   sdl_glob_sources("${SDL3_SOURCE_DIR}/src/locale/unix/*.c")
   set(HAVE_SDL_LOCALE TRUE)
 
+  if(SDL_VIDEO AND SDL_WASMER_VIDEO)
+    # <wasmer/gui.h> declares the host's imports itself: there is nothing to link.
+    set(SDL_WASMER_GUI_INCLUDE_DIR "" CACHE PATH "Directory that has wasmer/gui.h, when the sysroot does not")
+    cmake_push_check_state()
+    if(SDL_WASMER_GUI_INCLUDE_DIR)
+      list(APPEND CMAKE_REQUIRED_INCLUDES "${SDL_WASMER_GUI_INCLUDE_DIR}")
+    endif()
+    check_include_file("wasmer/gui.h" HAVE_WASMER_GUI_H)
+    cmake_pop_check_state()
+    if(HAVE_WASMER_GUI_H)
+      if(SDL_WASMER_GUI_INCLUDE_DIR)
+        sdl_include_directories(PRIVATE SYSTEM "${SDL_WASMER_GUI_INCLUDE_DIR}")
+      endif()
+      set(SDL_VIDEO_DRIVER_WASMER 1)
+      sdl_glob_sources(
+        "${SDL3_SOURCE_DIR}/src/video/wasmer/*.c"
+        "${SDL3_SOURCE_DIR}/src/video/wasmer/*.h"
+      )
+      set(HAVE_WASMER_VIDEO TRUE)
+      set(HAVE_SDL_VIDEO TRUE)
+    else()
+      message(STATUS "wasmer/gui.h not found: set SDL_WASMER_GUI_INCLUDE_DIR to build the Wasmer video driver")
+    endif()
+  endif()
+
 elseif(UNIX AND NOT APPLE AND NOT RISCOS AND NOT HAIKU)
 
   set(SDL_DISABLE_DLOPEN_NOTES TRUE)
