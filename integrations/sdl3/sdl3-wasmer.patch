diff --git a/src/render/software/SDL_render_sw.c b/src/render/software/SDL_render_sw.c
index ce3a3f5..ce07e93 100644
--- a/src/render/software/SDL_render_sw.c
+++ b/src/render/software/SDL_render_sw.c
@@ -1035,6 +1035,17 @@ static bool SW_RenderPresent(SDL_Renderer *renderer)
     return SDL_UpdateWindowSurface(window);
 }
 
+static bool SW_SetVSync(SDL_Renderer *renderer, const int vsync)
+{
+    // A video driver that can pace the window framebuffer on the display
+    // does it better than sleeping between frames can. Where there is none,
+    // this fails and vsync is simulated, as before.
+    if (!renderer->window) {
+        return SDL_Unsupported();
+    }
+    return SDL_SetWindowSurfaceVSync(renderer->window, vsync);
+}
+
 static void SW_DestroyTexture(SDL_Renderer *renderer, SDL_Texture *texture)
 {
     SDL_Surface *surface = (SDL_Surface *)texture->internal;
@@ -1202,6 +1213,7 @@ bool SW_CreateRendererForSurface(SDL_Renderer *renderer, SDL_Surface *surface, S
     renderer->RunCommandQueue = SW_RunCommandQueue;
     renderer->RenderReadPixels = SW_RenderReadPixels;
     renderer->RenderPresent = SW_RenderPresent;
+    renderer->SetVSync = SW_SetVSync;
     renderer->DestroyTexture = SW_DestroyTexture;
     renderer->DestroyRenderer = SW_DestroyRenderer;
     renderer->internal = data;
