diff --git a/Cargo.toml b/Cargo.toml
index 68238c0..c053725 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -110,11 +110,16 @@ objc2-quartz-core = { version = "0.3.2", default-features = false, features = [
     "CATransaction",
 ] }
 
-[target.'cfg(target_family = "wasm")'.dependencies]
+# WASIX: frames go to the Wasmer runtime, through the imports this crate declares.
+[target.'cfg(all(target_os = "wasi", target_vendor = "wasmer"))'.dependencies]
+wasmer-gui-sys = "0.1"
+
+# Web only: WASIX (`wasm32-wasmer-wasi`) is `target_family = "wasm"` too, but has no JS host.
+[target.'cfg(all(target_family = "wasm", not(all(target_os = "wasi", target_vendor = "wasmer"))))'.dependencies]
 js-sys = "0.3.63"
 wasm-bindgen = "0.2.86"
 
-[target.'cfg(target_family = "wasm")'.dependencies.web-sys]
+[target.'cfg(all(target_family = "wasm", not(all(target_os = "wasi", target_vendor = "wasmer"))))'.dependencies.web-sys]
 version = "0.3.55"
 features = [
     "CanvasRenderingContext2d",
@@ -152,12 +157,17 @@ features = ["jpeg"]
 # Turn rayon back on everywhere else; creating the separate entry resets the features to default.
 rayon = "1.5.1"
 
-[target.'cfg(target_family = "wasm")'.dev-dependencies]
+[target.'cfg(all(target_family = "wasm", not(all(target_os = "wasi", target_vendor = "wasmer"))))'.dev-dependencies]
 wasm-bindgen-test = "0.3"
 
 [target.'cfg(not(any(target_os = "android", target_vendor = "apple", target_os = "redox", target_family = "wasm", target_os = "windows")))'.dev-dependencies]
 rustix = { version = "1.0.1", features = ["event"] }
 
+# `target_vendor = "wasmer"` (WASIX) is only known to the WASIX toolchain's rustc; without this,
+# upstream toolchains warn about every `#[cfg(...)]` that selects the WASIX backend.
+[lints.rust]
+unexpected_cfgs = { level = "warn", check-cfg = ['cfg(target_vendor, values("wasmer"))'] }
+
 [workspace]
 members = ["run-wasm"]
 
