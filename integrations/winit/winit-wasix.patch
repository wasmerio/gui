diff --git a/Cargo.toml b/Cargo.toml
index 71f7c58..0138f6a 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -293,7 +293,10 @@ xkbcommon-dl = "0.4.2"
 orbclient = { version = "0.3.47", default-features = false }
 redox_syscall = "0.4.1"
 
-[target.'cfg(target_family = "wasm")'.dependencies]
+# Web only. WASIX (`wasm32-wasmer-wasi`) is also `target_family = "wasm"`, but has no JS host, so
+# the `wasm-bindgen` family must not be pulled in there (`target_os = "unknown"` is exactly the
+# `web_platform` alias from `build.rs`).
+[target.'cfg(all(target_family = "wasm", target_os = "unknown"))'.dependencies]
 js-sys = "0.3.70"
 pin-project = "1"
 wasm-bindgen = "0.2.93"
@@ -351,11 +354,16 @@ web_sys = { package = "web-sys", version = "0.3.70", features = [
     "Worker",
 ] }
 
-[target.'cfg(all(target_family = "wasm", target_feature = "atomics"))'.dependencies]
+# WASIX: windows and input come from the Wasmer runtime, through the imports
+# this crate declares.
+[target.'cfg(all(target_os = "wasi", target_vendor = "wasmer"))'.dependencies]
+wasmer-gui-sys = "0.1"
+
+[target.'cfg(all(target_family = "wasm", target_os = "unknown", target_feature = "atomics"))'.dependencies]
 atomic-waker = "1"
 concurrent-queue = { version = "2", default-features = false }
 
-[target.'cfg(target_family = "wasm")'.dev-dependencies]
+[target.'cfg(all(target_family = "wasm", target_os = "unknown"))'.dev-dependencies]
 console_error_panic_hook = "0.1"
 tracing-web = "0.1"
 
diff --git a/build.rs b/build.rs
index 6a4528b..7c2d529 100644
--- a/build.rs
+++ b/build.rs
@@ -15,6 +15,8 @@ fn main() {
         apple: { any(target_os = "ios", target_os = "macos") },
         free_unix: { all(unix, not(apple), not(android_platform), not(target_os = "emscripten")) },
         redox: { target_os = "redox" },
+        // WASIX (`wasm32-wasmer-wasi`): `target_family = "wasm"`, but *not* the Web.
+        wasix_platform: { all(target_os = "wasi", target_vendor = "wasmer") },
 
         // Native displays.
         x11_platform: { all(feature = "x11", free_unix, not(redox)) },
