+#[cfg(all(test, feature = "gui"))]
+mod gui_tests {
+    use std::sync::Arc;
+
+    use super::*;
+    use wasmer_wasix::{
+        PluggableRuntime, WasiError, runtime::task_manager::tokio::TokioTaskManager,
+    };
+
+    /// Checks the ABI version, opens a connection to the window system and a
+    /// window, and closes both. An import this host does not know has to
+    /// answer 0, "not implemented".
+    fn gui_guest() -> Vec<u8> {
+        wat2wasm(
+            br#"(module
+                (import "wasi_snapshot_preview1" "proc_exit" (func $proc_exit (param i32)))
+                (import "wasmer_gui_v0" "wguiGetVersion" (func $version (result i32)))
+                (import "wasmer_gui_v0" "wguiCreateInstance" (func $create_instance (param i32 i32) (result i32)))
+                (import "wasmer_gui_v0" "wguiInstanceCreateWindow" (func $create_window (param i32 i32 i32) (result i32)))
+                (import "wasmer_gui_v0" "wguiWindowDestroy" (func $destroy_window (param i32)))
+                (import "wasmer_gui_v0" "wguiInstanceDestroy" (func $destroy_instance (param i32)))
+                (import "wasmer_gui_v0" "wguiFromALaterHeader" (func $later (param i32) (result i32)))
+
+                (memory (export "memory") 1)
+
+                (func (export "_start")
+                    ;; The major version is in the upper half.
+                    (if (i32.shr_u (call $version) (i32.const 16))
+                        (then (call $proc_exit (i32.const 10))))
+
+                    ;; WGUIStatus_Success is 1; the handles are written at 16 and 20.
+                    (if (i32.ne (call $create_instance (i32.const 0) (i32.const 16)) (i32.const 1))
+                        (then (call $proc_exit (i32.const 11))))
+                    (if (i32.ne
+                            (call $create_window (i32.load (i32.const 16)) (i32.const 0) (i32.const 20))
+                            (i32.const 1))
+                        (then (call $proc_exit (i32.const 12))))
+
+                    (if (call $later (i32.const 0))
+                        (then (call $proc_exit (i32.const 13))))
+
+                    (call $destroy_window (i32.load (i32.const 20)))
+                    (call $destroy_instance (i32.load (i32.const 16)))
+                )
+            )"#,
+        )
+        .expect("guest wat parses")
+        .into_owned()
+    }
+
+    #[test]
+    fn cli_gui_runtime_wrapper_runs_wasix_guest() {
+        let wasm = gui_guest();
+        let store = Store::default();
+        let module = Module::new(&store, &wasm).expect("guest module compiles");
+        assert!(wasmer_gui::module_needs_gui(&module).is_some());
+
+        let tokio_runtime = tokio::runtime::Builder::new_multi_thread()
+            .enable_all()
+            .build()
+            .expect("tokio runtime starts");
+        let _guard = tokio_runtime.enter();
+        let mut base_runtime = PluggableRuntime::new(Arc::new(TokioTaskManager::new(
+            tokio_runtime.handle().clone(),
+        )));
+        base_runtime.set_engine(store.engine().clone());
+
+        let ctx = wasmer_gui::GuiCtx::default();
+        let runtime = wrap_runtime_with_gui(&ctx, Arc::new(base_runtime));
+        let mut import_store = runtime.new_store();
+        let mut import_store_mut = import_store.as_store_mut();
+        let (imports, _state) = runtime
+            .additional_imports(&module, &mut import_store_mut)
+            .expect("gui imports are created");
+        assert!(imports.exists("wasmer_gui_v0", "wguiCreateInstance"));
+
+        let result = WasiRunner::new().run_wasm(
+            RuntimeOrEngine::Runtime(runtime),
+            "gui-cli-smoke",
+            module,
+            ModuleHash::new(&wasm),
+        );
+
+        match result {
+            Ok(()) => {}
+            Err(err) => {
+                if let Some(WasiError::Exit(code)) = err.downcast_ref::<WasiError>() {
+                    panic!("guest exited with status {code}");
+                }
+                panic!("guest failed: {err:?}");
+            }
+        }
+        // Nothing of the guest is left behind.
+        assert_eq!(ctx.usage().windows, 0);
+        assert_eq!(ctx.usage().instances, 0);
+    }
+}
