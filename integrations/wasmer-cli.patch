+    /// Runs the command with its windows on the desktop. The window system's
+    /// loop belongs to the main thread, so the command itself moves to
+    /// another one; the loop is only started when a guest opens a window.
+    /// WebGPU guests draw on those windows.
+    #[cfg(feature = "gui-window")]
+    fn execute_with_gui_windows(self, output: Output) -> ! {
+        use std::time::Duration;
+        use wasmer_gui::native::{CloseBehavior, GuiExit, GuiMainThread, NativeOptions};
+
+        let (main_thread, windows) = GuiMainThread::with_options(NativeOptions {
+            // A guest is asked to close, and decides. One that does not even
+            // read the request is stuck, and the run ends.
+            close: CloseBehavior::RequestThenEnd(Duration::from_secs(2)),
+            ..NativeOptions::default()
+        });
+        // Surfaces a guest creates for anything but one of its windows are
+        // drawn, and shown to nobody.
+        let offscreen: Arc<dyn wasmer_webgpu::surface::SurfaceProvider> =
+            Arc::new(wasmer_webgpu::surface::HeadlessSurfaces::default());
+        let webgpu = wasmer_webgpu::WebGpuCtx::builder()
+            .surface_provider(windows.surfaces(Some(offscreen)))
+            .build();
+        let gui = wasmer_gui::GuiCtx::builder()
+            .window_system(Arc::new(windows))
+            .build();
+        let (gui_control, webgpu_control) = (gui.runtime_control(), webgpu.runtime_control());
+        let _ = self.gui.set(gui);
+        let _ = self.webgpu.set(webgpu);
+        match main_thread.run(move || self.execute_inner(output)) {
+            Ok(GuiExit::Finished(result)) => exit_with_wasi_exit_code(result),
+            Ok(GuiExit::Closed) => {
+                gui_control.terminate_all();
+                webgpu_control.terminate_all();
+                std::process::exit(0)
+            }
+            Err(error) => exit_with_wasi_exit_code(Err(error)),
+        }
+    }
