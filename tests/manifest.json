    {"name": "signals_sleeping", "program": "signals", "args": ["sleep"]},
    {"name": "basics", "program": "events", "script": "basics"},
    {"name": "requests", "program": "events", "script": "requests"},
    {"name": "text", "program": "events", "script": "text"},
    {"name": "clipboard", "program": "events", "script": "clipboard"},
    {"name": "clipboard_asking", "program": "events", "script": "clipboard_asking"},
    {"name": "clipboard_denied", "program": "events", "script": "clipboard_denied"},
    {"name": "touch", "program": "events", "script": "touch"},
